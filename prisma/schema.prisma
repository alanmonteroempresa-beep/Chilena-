// =============================================================================
// CHILENA — Esquema de base de datos (Prisma 7 + Supabase Postgres)
// Fuente funcional: docs/PRD.md · Carta e insignias: docs/CARTA_E_INSIGNIAS.md
// Convenciones:
//   - Tablas en snake_case vía @@map; campos camelCase.
//   - User.id es propio (uuid). User.authId = auth.users.id de Supabase cuando
//     la persona reclama su perfil. Un perfil puede existir SIN reclamar
//     (lo crea el delegado o la liga) — PRD §4.3 "Reclama tu perfil".
//   - Dinero SIEMPRE en centavos (Int), MXN. La app NO mueve dinero en la beta.
//   - Equipos: los partidos apuntan a Team (sirve para torneo y para retas);
//     la inscripción a torneo es TournamentTeam.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

